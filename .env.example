# TRADAR environment configuration
#
# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings -> API). .env.local is gitignored and must never
# be committed.
#
# Without these variables TRADAR still builds and runs, but authentication and
# persistence are disabled and the UI shows its empty states.

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable key (safe to expose to the browser; it is
# constrained by Row Level Security).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NOTE: never place the service_role key in this project. It bypasses RLS and
# must only be used in trusted server-side tooling outside the web app.
